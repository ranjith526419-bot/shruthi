{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in the platform",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["donor", "seeker", "hospital", "admin"] },
        "phone": { "type": "string", "maxLength": 20 },
        "city": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "displayName", "role"]
    },
    "Donor": {
      "title": "Donor",
      "description": "Registered blood donor details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "dateOfBirth": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "lastDonationDate": { "type": "string", "maxLength": 30 },
        "isAvailable": { "type": "boolean" },
        "totalDonations": { "type": "number" },
        "consentGiven": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "fullName", "bloodGroup", "city", "isAvailable", "consentGiven"]
    },
    "Hospital": {
      "title": "Hospital",
      "description": "Registered hospital or blood bank facility",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "type": { "type": "string", "enum": ["hospital", "blood_bank"] },
        "licenseNumber": { "type": "string", "maxLength": 50 },
        "contactPhone": { "type": "string", "maxLength": 20 },
        "emergencyPhone": { "type": "string", "maxLength": 20 },
        "email": { "type": "string", "maxLength": 128 },
        "address": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "isVerified": { "type": "boolean" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "city", "contactPhone", "isVerified"]
    },
    "BloodInventory": {
      "title": "BloodInventory",
      "description": "Available blood units inventory tracked by hospital or blood bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "hospitalId": { "type": "string", "maxLength": 128 },
        "hospitalName": { "type": "string", "maxLength": 150 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "unitsAvailable": { "type": "number" },
        "componentType": { "type": "string", "enum": ["whole_blood", "packed_red_cells", "platelets", "plasma"] },
        "collectionDate": { "type": "string", "maxLength": 30 },
        "expiryDate": { "type": "string", "maxLength": 30 },
        "status": { "type": "string", "enum": ["available", "low", "critical", "quarantine", "expired"] },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "hospitalId", "bloodGroup", "unitsAvailable", "status"]
    },
    "BloodRequest": {
      "title": "BloodRequest",
      "description": "Patient blood requirement request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "requesterId": { "type": "string", "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 100 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "unitsRequired": { "type": "number" },
        "hospitalName": { "type": "string", "maxLength": 150 },
        "hospitalId": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "requiredDate": { "type": "string", "maxLength": 30 },
        "urgency": { "type": "string", "enum": ["routine", "urgent", "critical"] },
        "contactName": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 20 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "in_progress", "fulfilled", "cancelled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "requesterId", "patientName", "bloodGroup", "unitsRequired", "hospitalName", "city", "urgency", "status"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Completed or scheduled donation records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "donorId": { "type": "string", "maxLength": 128 },
        "donorName": { "type": "string", "maxLength": 100 },
        "bloodGroup": { "type": "string", "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"] },
        "hospitalId": { "type": "string", "maxLength": 128 },
        "hospitalName": { "type": "string", "maxLength": 150 },
        "donationDate": { "type": "string", "maxLength": 30 },
        "unitsDonated": { "type": "number" },
        "status": { "type": "string", "enum": ["scheduled", "completed", "cancelled"] },
        "screeningNotes": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "donorId", "bloodGroup", "hospitalId", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications for alerts and updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["emergency", "request", "inventory", "donation", "system"] },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "type", "isRead"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit and activity log events",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/donors/{donorId}": {
      "schema": { "$ref": "#/entities/Donor" },
      "description": "Registered donor profiles"
    },
    "/hospitals/{hospitalId}": {
      "schema": { "$ref": "#/entities/Hospital" },
      "description": "Hospitals and blood banks"
    },
    "/bloodInventory/{inventoryId}": {
      "schema": { "$ref": "#/entities/BloodInventory" },
      "description": "Blood stock inventory units"
    },
    "/bloodRequests/{requestId}": {
      "schema": { "$ref": "#/entities/BloodRequest" },
      "description": "Patient blood requirement requests"
    },
    "/donations/{donationId}": {
      "schema": { "$ref": "#/entities/Donation" },
      "description": "Donation history and schedules"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User alerts and notifications"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "System activity logs"
    }
  }
}
